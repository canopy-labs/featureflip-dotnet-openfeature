<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Featureflip.OpenFeature</RootNamespace>
    <PackageId>Featureflip.OpenFeature</PackageId>
    <Version>0.3.1</Version>
    <Description>OpenFeature provider for Featureflip (.NET server SDK)</Description>
    <Authors>Canopy Labs</Authors>
    <Company>Canopy Labs LLC</Company>
    <Copyright>Copyright (c) 2026 Canopy Labs LLC</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://featureflip.io/docs/integrations/openfeature/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/canopy-labs/featureflip-dotnet-openfeature</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>openfeature;feature-flags;featureflip;provider</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenFeature" Version="2.14.1" />
    <PackageReference Include="Featureflip.Client" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Featureflip.OpenFeature.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
</Project>
